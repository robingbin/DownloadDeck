{
  "manifest_version": 3,
  "name": "DownloadDeck Integration",
  "version": "1.3.1",
  "description": "Send browser downloads and videos (YouTube etc.) to the DownloadDeck desktop app.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "cookies",
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DownloadDeck"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "video_button.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}